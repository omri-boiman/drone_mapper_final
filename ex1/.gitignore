# CMake / Conan build output
build/

# Conan local cache (generated by conan install)
.conan/
.conan2/

# CMake generated user presets are regenerated by conan install — keep
# CMakeUserPresets.json committed so the cmake --preset command works out of the box

# Editor / IDE — personal settings excluded, shared IntelliSense config committed
.vscode/settings.json
.vscode/launch.json
*.code-workspace
.idea/
*.suo
*.user

# Compiled object files
*.o
*.obj
*.a
*.so
*.dylib
*.exe

# Clangd / compile_commands.json (generated by CMake)
compile_commands.json

# macOS
.DS_Store

# Windows
Thumbs.db
